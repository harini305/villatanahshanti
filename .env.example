# Public site URL used for canonical links, sitemap and Open Graph.
# Defaults to https://www.villatanahshanti.com when unset.
NEXT_PUBLIC_SITE_URL=https://www.villatanahshanti.com

# Form-service endpoint that receives contact enquiries (e.g. a Formspree or Web3Forms
# form URL owned by the villa). Leave empty until a real account exists: the contact
# form will then explain that online submission is unavailable and point to Facebook/Airbnb.
NEXT_PUBLIC_FORM_ENDPOINT=
